# Where the station publishes what it is doing. Create it on the laptop with:
#   .venv/bin/python main.py site-init
GIST_ID=
# Optional. A secret gist is readable by anyone who knows its id, so the site
# does not strictly need a token -- set one if you would rather it used auth.
GITHUB_TOKEN=
GIST_FILENAME=radio.json

# The password for the whole site. If this is unset, NOBODY gets in, on
# purpose: a private station should never fall open because a variable was
# forgotten.
SITE_PASSWORD=

# One of these two makes the player work.
# STREAM_URL is the direct listen link from caster.fm (ends in .mp3 or /;).
# It gets the nice built-in button. PLAYER_EMBED_URL is caster.fm's own
# embeddable player, used only when there is no STREAM_URL.
STREAM_URL=
PLAYER_EMBED_URL=
