# ---------------------------------------------------------------------------
# AI Radio secrets.  Copy to ".env" and fill in.  Never commit the real .env.
# ---------------------------------------------------------------------------

# --- caster.fm (Icecast source) -------------------------------------------
# From your caster.fm dashboard -> "Server details" / "Source connection".
ICECAST_HOST=your-station.caster.fm
ICECAST_PORT=8000
ICECAST_MOUNT=/stream
ICECAST_USER=source
ICECAST_PASSWORD=changeme

# --- Last.fm (free API key: https://www.last.fm/api/account/create) -------
LASTFM_API_KEY=

# --- LLM brain (need at least one; both = automatic failover) --------------
# Gemini free key : https://aistudio.google.com/apikey
# Groq free key   : https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Discord bot ----------------------------------------------------------
# https://discord.com/developers/applications -> New Application -> Bot -> Token
# Enable "MESSAGE CONTENT INTENT" under Bot -> Privileged Gateway Intents.
DISCORD_TOKEN=
# Numeric channel ID the bot listens in (Discord: enable Developer Mode,
# right-click the channel -> Copy Channel ID).  Leave blank to listen everywhere
# the bot can see, which is fine for a private one-person server.
DISCORD_CHANNEL_ID=
